<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudAndBear.Desktop.ViewModels"
             x:Class="CloudAndBear.Desktop.Views.KubernetesView"
             x:DataType="vm:KubernetesViewModel">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#16212d" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#8a99a8" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="#e0e0e0" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Text="Kubernetes" FontSize="32" FontWeight="SemiBold" Foreground="#9ecbff" />
      <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="value" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
      <Button Grid.Column="2" Content="Osveži" Command="{Binding Refresh}" />
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding Problem}" Foreground="#ff5f5f" FontSize="18" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />

    <Grid Grid.Row="2" ColumnDefinitions="240,*" ColumnSpacing="16">

      <!-- konteksti -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <TextBlock Classes="label" Text="Konteksti" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Contexts}" SelectedItem="{Binding SelectedContext}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="16" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="{Binding KubeconfigText}" Classes="label" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">

        <!-- čvorovi -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Čvorovi" />
            <ItemsControl ItemsSource="{Binding Nodes}" TextElement.FontSize="16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NodeRow">
                  <Grid ColumnDefinitions="*,210,140,130" Margin="0,2">
                    <TextBlock Text="{Binding Node.Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Node.Status}" Foreground="{Binding Brush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Node.Roles}" Foreground="#8a99a8" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Node.Version}" Foreground="#8a99a8" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- podovi -->
        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock Classes="label" Text="Podovi (svi namespace-ovi)" />
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Pods}" TextElement.FontSize="16">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PodRow">
                    <Grid ColumnDefinitions="170,*,70,170,70,60" Margin="0,2">
                      <TextBlock Text="{Binding Pod.Namespace}" Foreground="#8a99a8" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Pod.Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Pod.Ready}" />
                      <TextBlock Grid.Column="3" Text="{Binding Pod.Status}" Foreground="{Binding Brush}" />
                      <TextBlock Grid.Column="4" Text="{Binding Pod.Restarts}" Foreground="#8a99a8" />
                      <TextBlock Grid.Column="5" Text="{Binding Pod.Age}" Foreground="#8a99a8" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

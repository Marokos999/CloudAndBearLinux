#!/bin/sh
# prerm paketa cloudandbear-desktop
set -e

case "$1" in
remove | deconfigure)
    # zaustavljanje vraća konzolnu prijavu na tty1 (OnSuccess= u servisu)
    if [ -d /run/systemd/system ]; then
        systemctl stop cloudandbear-gui.service || true
    fi
    systemctl disable cloudandbear-gui.service > /dev/null 2>&1 || true
    ;;
esac

exit 0

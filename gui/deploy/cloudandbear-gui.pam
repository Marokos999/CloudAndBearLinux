# PAM za servis cloudandbear-gui (ide u /etc/pam.d/cloudandbear-gui).
# Nalog nema lozinku i ne prijavljuje se: servis samo traži od logind-a sesiju na tty1 (pam_systemd).
auth     required pam_permit.so
account  required pam_permit.so
session  required pam_unix.so
session  required pam_limits.so
session  optional pam_systemd.so
